// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?
  name          String?
  country       String?
  age           Int?
  interests     String[] @default([])
  balanceCoins  Int      @default(0)
  kycStatus     String   @default("pending") // pending, verified, rejected
  riskScore     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  devices            Device[]
  conversions        Conversion[]
  walletTransactions WalletTransaction[]
  withdrawals        Withdrawal[]
  referralsAsReferrer Referral[] @relation("Referrer")
  referralsAsReferee Referral[]  @relation("Referee")
  games              Game[]
  caseRewards        CaseReward[]
  extensionTasks     ExtensionTask[]

  @@index([email])
  @@index([riskScore])
}

model Device {
  id          String   @id @default(uuid())
  userId      String
  fingerprint String
  ip          String?
  userAgent   String?
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([fingerprint])
  @@index([ip])
}

model Offer {
  id            String   @id @default(uuid())
  provider      String   // CPX, AdGate, AyeT, Lootably
  externalId    String
  title         String
  description   String?
  type          String   // survey, offer, video, task
  payoutEur     Float
  rewardUserEur Float   // 75% of payoutEur
  rewardCoins   Int      // rewardUserEur * 1000
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversions Conversion[]

  @@unique([provider, externalId])
  @@index([provider, isActive])
}

model Conversion {
  id            String   @id @default(uuid())
  userId        String
  offerId       String
  providerTx    String?  @unique
  status        String   @default("pending") // pending, approved, rejected
  approvedAt    DateTime?
  coinsAwarded  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id])

  @@index([userId, status])
  @@index([providerTx])
  @@index([status])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // credit, debit, bonus, withdraw, game_win, game_loss
  amountCoins Int
  refId       String?  // reference to conversion, withdrawal, game, etc.
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model Withdrawal {
  id          String   @id @default(uuid())
  userId      String
  method      String   // paypal, revolut, giftcard
  amountEur   Float
  amountCoins Int
  status      String   @default("pending") // pending, approved, rejected, completed
  payoutId    String?  // external payout ID (Tremendous, etc.)
  metadata    Json?    // additional data (email, account, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  refereeId    String
  bonusCoins   Int      @default(0)
  lifetimeEarned Int    @default(0) // total coins earned from this referral
  createdAt    DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
  @@index([referrerId])
}

model Game {
  id          String   @id @default(uuid())
  type        String   // coinflip, duel, case_open
  userId      String?
  userId2     String?  // for duels
  betCoins    Int
  result      Json?    // game result data
  winnerId    String?
  platformFee Int      @default(0) // 5% for duels
  status      String   @default("pending") // pending, completed, cancelled
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([status])
}

model Case {
  id          String   @id @default(uuid())
  name        String
  description String?
  costCoins   Int
  rewardsJson Json     // array of {type, value, probability}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards CaseReward[]

  @@index([isActive])
}

model CaseReward {
  id          String   @id @default(uuid())
  userId      String
  caseId      String
  rewardType  String   // coins, giftcard, multiplier
  rewardValue Json     // actual reward value
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExtensionTask {
  id          String   @id @default(uuid())
  userId      String
  targetUrl   String
  status      String   @default("pending") // pending, completed, failed
  payoutCoins Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model DailyBonus {
  id          String   @id @default(uuid())
  userId      String   @unique
  streak      Int      @default(0)
  lastClaimed DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}


